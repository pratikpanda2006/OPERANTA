# ==============================================================================
# MarginGuard — Environment, Dependency and Secret Exclusions
# ==============================================================================

# Environment variables and credentials (strictly ignored)
.env
.env.*
*.env
*.env.*
!**/.env.example
!**/.env.*.example
frontend/.env.development
frontend/.env.local
backend/.env
backend/.env.*

# Python virtual environment and bytecode
__pycache__/
*.py[cod]
*$py.class
backend/.venv/
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/

# Node dependencies and production build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
.coverage
.pytest_cache/
htmlcov/

# Operating System & IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
