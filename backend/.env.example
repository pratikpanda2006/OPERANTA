# ==============================================================================
# MarginGuard Backend Configuration Template (.env.example)
# Copy this file to backend/.env and populate with local development credentials.
# NOTE: backend/.env is strictly ignored by Git and must never be committed.
# ==============================================================================

# Supabase Transaction-Mode Pooler (Port 6543) — Used for Application Runtime
# Note: statement_cache_size=0 is enforced in code for transaction pooling.
# In production, the username must be the provisioned runtime LOGIN role (e.g., marginguard_runtime.<PROJECT-REF>)
# which inherits permissions via: GRANT marginguard_app_user TO marginguard_runtime;
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.co:6543/postgres

# Supabase Session-Mode Pooler / Direct Host (Port 5432) — Used for Migration Runner & DDL
DIRECT_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.co:5432/postgres

# Connection Pool Sizing
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# Multi-Tenant Active Scope for Pilot Demo
ACTIVE_MERCHANT_ID=merchant_northstar

# ---------------------------------------------------------------------------
# Local-only: allow disabling TLS for the migration runner.
# ---------------------------------------------------------------------------
# Set to true ONLY when targeting a loopback address (127.0.0.1 / ::1 / localhost)
# for offline local PostgreSQL validation.  The runner rejects this flag for any
# non-loopback host — it will not disable TLS for Supabase or any remote server.
# NEVER set this to true in production or staging.
# Default: false (TLS is always required for remote connections).
# MIGRATE_ALLOW_INSECURE_LOCAL=false

